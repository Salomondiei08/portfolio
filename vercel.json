{
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "s.reinvent-labs.com" }],
      "destination": "/links"
    },
    { "source": "/impactia", "destination": "/impactia/index.html" },
    { "source": "/impactia/", "destination": "/impactia/index.html" }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.pdf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
